# Copy to .env (Bun loads it automatically).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# DB_PATH=/opt/blog/data/blog.sqlite   # uploaded images go in a "media" folder next to it

# --- Site / SEO
# Public URL, used for canonical links, Open Graph, sitemap and RSS. No trailing slash.
SITE_URL=https://blog.example.com
BLOG_TITLE=My Blog
BLOG_DESCRIPTION=Notes on building small, fast things.
SITE_LANG=en
# Author name shown on posts and in search-engine structured data (defaults to the username).
AUTHOR_NAME=

# --- Login
# The login page is not linked anywhere and only exists at this path; /login returns 404.
# Pick something hard to guess, e.g. run: bun -e 'console.log("/" + crypto.randomUUID().slice(0, 13))'
LOGIN_PATH=/change-me-secret-door

# Set both to 1 in production behind Caddy/nginx with HTTPS.
TRUST_PROXY=1
COOKIE_SECURE=1

# Login rate limit (per window).
LOGIN_WINDOW_MIN=15
LOGIN_MAX_PER_IP=20
LOGIN_MAX_PER_IP_USER=5
LOGIN_MAX_PER_USER=50
